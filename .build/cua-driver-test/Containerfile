# .build/cua-driver-test/Containerfile (generated -- do not edit)

ARG BASE_IMAGE=quay.io/archlinux/archlinux:base-20260719.0.558306

FROM scratch AS cua-driver
COPY candy/cua-driver/ /

FROM scratch AS cua-session
COPY candy/cua-session/ /

FROM scratch AS cua-guest
COPY candy/cua-guest/ /

FROM ${BASE_IMAGE}

# Bootstrap
RUN --mount=type=cache,id=charly-var-cache-pacman-pkg,dst=/var/cache/pacman/pkg,sharing=locked \
    pacman-key --init && pacman -Syu --noconfirm --needed curl ca-certificates && \
    { [ -L /usr/local ] && mkdir -p "$(readlink /usr/local)"; mkdir -p /usr/local/bin; } && \
    ARCH=$(uname -m) && \
    case "$ARCH" in x86_64) ARCH=amd64;; aarch64) ARCH=arm64;; esac && \
    TASK_URL="https://github.com/go-task/task/releases/latest/download/task_linux_${ARCH}.tar.gz" && \
    (curl -fsSL "$TASK_URL" || wget -qO- "$TASK_URL") | tar -xzf - -C /usr/local/bin task

RUN if ! getent passwd 1000 >/dev/null 2>&1; then \
      LOGIN_SHELL=/bin/sh; [ -x /bin/bash ] && LOGIN_SHELL=/bin/bash; \
      if command -v useradd >/dev/null 2>&1; then \
        (getent group 1000 >/dev/null 2>&1 || groupadd -g 1000 user) && \
        useradd -m -u 1000 -g 1000 -s "$LOGIN_SHELL" user; \
      else \
        (getent group 1000 >/dev/null 2>&1 || addgroup -g 1000 user) && \
        adduser -D -h /home/user -u 1000 -G user -s "$LOGIN_SHELL" user; \
      fi; \
    fi

WORKDIR /home/user

# Layer: cua-driver
ARG TARGETARCH
ENV ARCH=${TARGETARCH}
RUN --mount=type=cache,id=charly-var-cache-pacman-pkg,dst=/var/cache/pacman/pkg,sharing=locked \
pacman-key --init && \
# Reseed pacman keyring from the locally-installed
# keyring packages (cachyos-keyring, archlinux-keyring).
# `--populate` is local-only and FAST (sub-second per
# repo); does NOT do keyserver roundtrips. Non-fatal
# (`|| true`) so air-gapped / restricted-network builds
# succeed when the keyring was already current.
(pacman-key --populate 2>/dev/null || true) && \
OMARCHY_ALLOW_DIRECT_PACMAN=1 pacman -Syu --noconfirm --needed libxi libxkbcommon at-spi2-core ffmpeg wf-recorder ydotool
RUN --mount=type=cache,id=charly-tmp-downloads,dst=/tmp/downloads,sharing=locked sh -c 'SH=/bin/sh; [ -x /bin/bash ] && SH=/bin/bash; exec "$SH" -c "$1"' sh 'export BUILD_ARCH=$(uname -m); mkdir -p /tmp/downloads; __u="https://github.com/trycua/cua/releases/download/cua-driver-rs-v0.29.1/cua-driver-rs-0.29.1-linux-x86_64-binary.tar.gz"; __c=/tmp/downloads/$(printf %s "$__u" | sha256sum | cut -c1-64); [ -s "$__c" ] || { curl -fsSL "$__u" -o "$__c.part" && mv -f "$__c.part" "$__c"; } && mkdir -p /opt/cua-driver && tar -xzf "$__c" -C /opt/cua-driver '
RUN --mount=type=bind,from=cua-driver,source=/,target=/ctx --mount=type=cache,id=charly-var-cache-pacman-pkg,dst=/var/cache/pacman/pkg,sharing=locked sh -c 'SH=/bin/sh; [ -x /bin/bash ] && SH=/bin/bash; exec "$SH"' sh <<'OVCMD'
BUILD_ARCH=$(uname -m)
case "$BUILD_ARCH" in
  x86_64) ARCH=amd64 ;;
  aarch64) ARCH=arm64 ;;
  armv7l|armv7|armhf) ARCH=arm ;;
  *) ARCH=$BUILD_ARCH ;;
esac
export BUILD_ARCH ARCH
set -e
set -eu
ln -sf /opt/cua-driver/cua-driver /usr/local/bin/cua-driver
ln -sf /opt/cua-driver/cua-cursor-theme /usr/local/bin/cua-cursor-theme
OVCMD
USER 1000
RUN --mount=type=bind,from=cua-driver,source=/,target=/ctx --mount=type=cache,id=charly-tmp-npm-cache-uid1000,dst=/tmp/npm-cache,uid=1000,gid=1000 sh -c 'SH=/bin/sh; [ -x /bin/bash ] && SH=/bin/bash; exec "$SH"' sh <<'OVCMD'
BUILD_ARCH=$(uname -m)
case "$BUILD_ARCH" in
  x86_64) ARCH=amd64 ;;
  aarch64) ARCH=arm64 ;;
  armv7l|armv7|armhf) ARCH=arm ;;
  *) ARCH=$BUILD_ARCH ;;
esac
export BUILD_ARCH ARCH
set -e
set -eu
# `telemetry disable` writes the preference under the user's home. At
# build time that is the image user's home; a persistent preference
# survives upgrades. Best-effort: an older build without the subcommand
# must not fail the image.
cua-driver telemetry disable 2>/dev/null || true
OVCMD
USER root

# Layer: cua-session
ARG TARGETARCH
ENV ARCH=${TARGETARCH}
RUN --mount=type=bind,from=cua-session,source=/,target=/ctx --mount=type=cache,id=charly-var-cache-pacman-pkg,dst=/var/cache/pacman/pkg,sharing=locked sh -c 'SH=/bin/sh; [ -x /bin/bash ] && SH=/bin/bash; exec "$SH"' sh <<'OVCMD'
BUILD_ARCH=$(uname -m)
case "$BUILD_ARCH" in
  x86_64) ARCH=amd64 ;;
  aarch64) ARCH=arm64 ;;
  armv7l|armv7|armhf) ARCH=arm ;;
  *) ARCH=$BUILD_ARCH ;;
esac
export BUILD_ARCH ARCH
set -e
set -eu
# supergateway is `npm install -g supergateway`. It is OPTIONAL: the
# cua-driver daemon is the core, and the :3000 MCP endpoint is a bridge
# in front of it. A guest without nodejs simply has no :3000 endpoint.
if command -v npm >/dev/null 2>&1; then
  npm install -g --no-fund --no-audit supergateway
  ln -sf "$(npm prefix -g)/bin/supergateway" /usr/local/bin/supergateway 2>/dev/null || true
else
  echo "npm absent — the optional cua-driver-mcp :3000 unit will not start (compose a nodejs candy to enable it)" >&2
fi
OVCMD
RUN --mount=type=bind,from=cua-session,source=/,target=/ctx --mount=type=cache,id=charly-var-cache-pacman-pkg,dst=/var/cache/pacman/pkg,sharing=locked sh -c 'SH=/bin/sh; [ -x /bin/bash ] && SH=/bin/bash; exec "$SH"' sh <<'OVCMD'
BUILD_ARCH=$(uname -m)
case "$BUILD_ARCH" in
  x86_64) ARCH=amd64 ;;
  aarch64) ARCH=arm64 ;;
  armv7l|armv7|armhf) ARCH=arm ;;
  *) ARCH=$BUILD_ARCH ;;
esac
export BUILD_ARCH ARCH
set -e
set -eu
mkdir -p /etc/systemd/user
cat > /etc/systemd/user/cua-driver.service <<'UNIT'
[Unit]
Description=Cua Driver daemon for the desktop session
After=graphical-session.target
PartOf=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
Environment=CUA_DRIVER_RS_ENABLE_WAYLAND=1
Environment=CUA_DRIVER_RS_UPDATE_CHECK=false
Environment=YDOTOOL_SOCKET=/run/user/1000/.ydotool_socket
ExecStart=/usr/local/bin/cua-driver serve --socket %h/.cache/cua-driver/cua-driver.sock
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical-session.target
UNIT

cat > /etc/systemd/user/cua-driver-mcp.service <<'UNIT'
[Unit]
Description=Cua Driver MCP over Streamable HTTP (:3000)
After=graphical-session.target cua-driver.service
Wants=cua-driver.service
PartOf=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
Environment=CUA_DRIVER_RS_ENABLE_WAYLAND=1
Environment=CUA_DRIVER_RS_UPDATE_CHECK=false
ExecStart=/usr/local/bin/supergateway --stdio "/usr/local/bin/cua-driver mcp" --outputTransport streamableHttp --stateful --sessionTimeout 3600000 --port 3000 --streamableHttpPath /mcp --healthEndpoint /healthz --cors --logLevel none
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical-session.target
UNIT
chmod 0644 /etc/systemd/user/cua-driver.service /etc/systemd/user/cua-driver-mcp.service
OVCMD
RUN --mount=type=bind,from=cua-session,source=/,target=/ctx --mount=type=cache,id=charly-var-cache-pacman-pkg,dst=/var/cache/pacman/pkg,sharing=locked sh -c 'SH=/bin/sh; [ -x /bin/bash ] && SH=/bin/bash; exec "$SH"' sh <<'OVCMD'
BUILD_ARCH=$(uname -m)
case "$BUILD_ARCH" in
  x86_64) ARCH=amd64 ;;
  aarch64) ARCH=arm64 ;;
  armv7l|armv7|armhf) ARCH=arm ;;
  *) ARCH=$BUILD_ARCH ;;
esac
export BUILD_ARCH ARCH
set -e
set -eu
mkdir -p /etc/systemd/user/graphical-session.target.wants
ln -sf ../cua-driver.service /etc/systemd/user/graphical-session.target.wants/cua-driver.service
ln -sf ../cua-driver-mcp.service /etc/systemd/user/graphical-session.target.wants/cua-driver-mcp.service
OVCMD

# Layer: cua-guest
ARG TARGETARCH
ENV ARCH=${TARGETARCH}
RUN --mount=type=bind,from=cua-guest,source=/,target=/ctx --mount=type=cache,id=charly-var-cache-pacman-pkg,dst=/var/cache/pacman/pkg,sharing=locked sh -c 'SH=/bin/sh; [ -x /bin/bash ] && SH=/bin/bash; exec "$SH"' sh <<'OVCMD'
BUILD_ARCH=$(uname -m)
case "$BUILD_ARCH" in
  x86_64) ARCH=amd64 ;;
  aarch64) ARCH=arm64 ;;
  armv7l|armv7|armhf) ARCH=arm ;;
  *) ARCH=$BUILD_ARCH ;;
esac
export BUILD_ARCH ARCH
set -e
set -eu
mkdir -p /etc/udev/rules.d
cat > /etc/udev/rules.d/99-cua-uinput.rules <<'RULE'
# cua-driver's isolated input route creates a virtual keyboard/pointer via
# uinput and attaches it to its own master pair, so the user's focus and
# pointer are never touched. The driver runs as the desktop user.
KERNEL=="uinput", MODE="0660", GROUP="input", OPTIONS+="static_node=uinput"
RULE
chmod 0644 /etc/udev/rules.d/99-cua-uinput.rules
OVCMD
RUN --mount=type=bind,from=cua-guest,source=/,target=/ctx --mount=type=cache,id=charly-var-cache-pacman-pkg,dst=/var/cache/pacman/pkg,sharing=locked sh -c 'SH=/bin/sh; [ -x /bin/bash ] && SH=/bin/bash; exec "$SH"' sh <<'OVCMD'
BUILD_ARCH=$(uname -m)
case "$BUILD_ARCH" in
  x86_64) ARCH=amd64 ;;
  aarch64) ARCH=arm64 ;;
  armv7l|armv7|armhf) ARCH=arm ;;
  *) ARCH=$BUILD_ARCH ;;
esac
export BUILD_ARCH ARCH
set -e
set -eu
# Only meaningful where netplan exists (Debian/Ubuntu). On Arch/Omarchy
# NetworkManager already DHCPs; writing a netplan would be inert.
if [ -d /etc/netplan ]; then
  cat > /etc/netplan/99-cua-dhcp.yaml <<'NETPLAN'
# DHCP on whatever NIC the hypervisor presents (enp1s0 under KubeVirt,
# ens3/enp0s3 under plain QEMU). Without it the guest never leases on Fleet.
network:
  version: 2
  ethernets:
    all-en:
      match: {name: "en*"}
      dhcp4: true
      dhcp-identifier: mac
    all-eth:
      match: {name: "eth*"}
      dhcp4: true
      dhcp-identifier: mac
NETPLAN
  chmod 0600 /etc/netplan/99-cua-dhcp.yaml
  echo "wrote /etc/netplan/99-cua-dhcp.yaml"
else
  echo "no /etc/netplan (NetworkManager distro) — skipping the DHCP netplan"
fi
OVCMD

USER 1000
# Image metadata
